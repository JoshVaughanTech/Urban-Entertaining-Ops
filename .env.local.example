# Copy to .env.local and fill in from the Supabase project dashboard.
# Nothing here is a real value — Josh supplies these.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Newer projects issue a publishable key; older ones an anon key. Either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → Database → Connection string → URI (session pooler)
# Used by Drizzle for migrations and the seed script.
DATABASE_URL=

# Where magic-link emails send the user back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 3 — transactional email for sending client quotes.
# RESEND_API_KEY comes from resend.com. QUOTE_FROM_EMAIL must be an address on a
# domain verified in Resend — without both, the app refuses to send rather than
# pretending it did.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=

# Who may sign in, before anyone has been added in the app.
# Comma separated; these addresses are admitted as admins. Once real people
# are on the Access list you can clear this. If it is empty AND nobody has
# been added yet, the first person to sign in becomes admin — so a fresh
# deployment is usable, and closes behind them.
ALLOWED_EMAILS=
