# Copy to .env.local and fill in from the Supabase project dashboard.
# Nothing here is a real value — Josh supplies these.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → Database → Connection string → URI (session pooler)
# Used by Drizzle for migrations and the seed script.
DATABASE_URL=

# Where magic-link emails send the user back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 3 — transactional email for sending client quotes.
RESEND_API_KEY=
